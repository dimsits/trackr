####################################
# API
####################################
# Base URL of the local Trackr backend, including the global /api prefix.
# Must stay in sync with the backend's PORT + API_PREFIX settings.
# The backend health check is then reachable at <NEXT_PUBLIC_API_URL>/health
# -> http://localhost:3001/api/health
NEXT_PUBLIC_API_URL=http://localhost:3001/api
