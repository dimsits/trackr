{
  "compilerOptions": {
    /* Runtime + module system.
       NestJS 12 core packages ship as ESM-only, which the legacy "node"
       resolver cannot resolve. "nodenext" reads each package's "exports"
       map instead. Emitted code stays CommonJS because this package.json
       has no "type": "module", so dist/ and the Jest/ts-jest setup are
       unchanged. */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,

    /* Language target */
    "target": "ES2023",
    "lib": ["ES2023"],

    /* Output */
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": false,

    /* NestJS decorators */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    /* Interop + DX */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Type safety */
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": false,

    /* Paths (optional but helps imports) */
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
