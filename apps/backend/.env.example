####################################
# App
####################################
NODE_ENV=development
PORT=3001
API_PREFIX=/api

####################################
# Frontend / CORS
####################################
FRONTEND_URL=http://localhost:3000

####################################
# Database (Prisma + Postgres)
####################################
# Local Docker Postgres example
DATABASE_URL=postgresql://trackr:trackrpass@localhost:5432/trackr?schema=public

####################################
# Authentication (JWT)
####################################
# Generate a long random string for production
JWT_SECRET=your-super-long-random-secret
JWT_EXPIRES_IN=7d

####################################
# Cloudflare R2 (File Uploads)
####################################
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=trackr

# Public base URL for downloads (used for signed URLs)
R2_PUBLIC_BASE_URL=https://your-bucket-id.r2.cloudflarestorage.com