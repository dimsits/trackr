####################################
# App
####################################
PORT=3001

# Global route prefix. The API is served at http://localhost:3001/<API_PREFIX>
# Leading/trailing slashes are normalised, so "api" and "/api" behave the same.
API_PREFIX=api

####################################
# CORS
####################################
# Comma-separated list of allowed browser origins (the frontend dev server).
CORS_ORIGIN=http://localhost:3000

####################################
# Database (Prisma + Postgres)
####################################
# Matches the credentials in the repository-root compose.yaml.
DATABASE_URL=postgresql://trackr:trackrpass@localhost:5432/trackr?schema=public

####################################
# Authentication (JWT)
####################################
# `npm run setup` generates a random secret here when it creates your .env.
# Never commit a real secret.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

####################################
# Cloudflare R2 (file uploads) - OPTIONAL in local development
####################################
# Leave these commented out to run Trackr without object storage. Every
# non-file feature keeps working; the upload/download endpoints respond with
# 503 "file storage is not configured" until R2 is set up.
#
# Set ALL FOUR of R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY /
# R2_BUCKET to enable file storage. Setting only some of them is rejected at
# boot so the configuration cannot be half-applied.
#
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=trackr
# R2_URL_TTL_SECONDS=600
